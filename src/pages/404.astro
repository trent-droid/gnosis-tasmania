---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.jsx'
import Footer from '../components/Footer.jsx'
---
<Layout
  title="Page Not Found | Gnosis Tasmania"
  description="The page you're looking for doesn't exist. Explore our Gnostic classes, teachings, and resources in Tasmania."
  canonicalPath="/404"
  robots="noindex, follow"
>
  <div className="min-h-screen bg-[#faf6ef] text-[#3a2f1f]">
    <Nav client:load />

    <section className="py-32 px-4">
      <div className="max-w-2xl mx-auto text-center">
        <p className="text-[#c9a96e] text-xs font-semibold uppercase tracking-widest mb-4">404</p>
        <h1 className="font-display text-4xl sm:text-5xl font-light text-[#2a1e12] mb-6">
          Page Not Found
        </h1>
        <div className="w-12 h-[2px] bg-[#c9a96e] mx-auto mb-8" />
        <p className="text-[#4a3a26] text-lg leading-relaxed mb-10">
          The page you're looking for doesn't exist or may have moved. Here are some places to continue exploring.
        </p>
        <div className="flex flex-wrap gap-4 justify-center">
          <a
            href="/"
            className="bg-[#c9a96e] hover:bg-[#b8963e] text-[#1c1409] font-semibold px-8 py-3 rounded-sm transition-colors tracking-wide text-sm"
          >
            Return Home
          </a>
          <a
            href="/courses"
            className="border border-[#c9a96e] text-[#c9a96e] hover:bg-[#c9a96e] hover:text-[#1c1409] font-semibold px-8 py-3 rounded-sm transition-colors tracking-wide text-sm"
          >
            View Courses
          </a>
          <a
            href="/contact"
            className="border border-[#c9a96e] text-[#c9a96e] hover:bg-[#c9a96e] hover:text-[#1c1409] font-semibold px-8 py-3 rounded-sm transition-colors tracking-wide text-sm"
          >
            Contact Us
          </a>
        </div>
      </div>
    </section>

    <Footer client:load />
  </div>
</Layout>
